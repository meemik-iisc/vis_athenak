# direnv: on cd into the repo, activate the conda environment named by
# CONDA_ENV in .env, so `python main.py` uses it.  Run `direnv allow` once, and
# again after editing this file.
#
# Only CONDA_ENV is taken from .env.  The root folders (ATHENAK_DIR, ...) are
# read from .env by Python on every run; exporting them here would make them
# shell variables, which take precedence, so edits to .env would only apply
# after the shell is restarted.
if [[ -f .env ]]; then
    watch_file .env
    CONDA_ENV=$(sed -n 's/^[[:space:]]*CONDA_ENV=["'\'']\{0,1\}\([^"'\'' #]*\).*/\1/p' .env | tail -n 1)
fi
if [[ -n "${CONDA_ENV:-}" ]]; then
    conda_exe="${CONDA_EXE:-$(command -v conda || echo "$HOME/miniconda3/bin/conda")}"
    layout anaconda "$CONDA_ENV" "$conda_exe"
fi
